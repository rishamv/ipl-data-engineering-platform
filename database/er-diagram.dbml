//////////////////////////////////////////////////////////
// IPL DATA ENGINEERING PLATFORM
// ER Diagram
//////////////////////////////////////////////////////////

Table COMPETITION {
  COMPETITION_ID int [pk]
  COMPETITION_NAME varchar
  SHORT_NAME varchar
  COUNTRY varchar
  GOVERNING_BODY varchar
  START_YEAR int
  CREATED_DATE date
  UPDATED_DATE date
}

Table SEASON {
  SEASON_ID int [pk]
  COMPETITION_ID int
  SEASON_NAME varchar
  START_DATE date
  END_DATE date
  TOTAL_MATCHES int
  STATUS varchar
  CREATED_DATE date
  UPDATED_DATE date
}

Table TEAM {
  TEAM_ID int [pk]
  COMPETITION_ID int
  TEAM_NAME varchar
  SHORT_NAME varchar
  HOME_CITY varchar
  STATE varchar
  COUNTRY varchar
  FOUNDED_YEAR int
  HOME_GROUND varchar
  ACTIVE_FLAG char
  CREATED_DATE date
  UPDATED_DATE date
}

Table PLAYER {
  PLAYER_ID int [pk]
  FULL_NAME varchar
  FIRST_NAME varchar
  LAST_NAME varchar
  DATE_OF_BIRTH date
  NATIONALITY varchar
  BATTING_STYLE varchar
  BOWLING_STYLE varchar
  PRIMARY_ROLE varchar
  DEBUT_YEAR int
  ACTIVE_FLAG char
  CREATED_DATE date
  UPDATED_DATE date
}

Table PLAYER_TEAM_HISTORY {
  HISTORY_ID int [pk]
  PLAYER_ID int
  TEAM_ID int
  SEASON_ID int
  JERSEY_NUMBER int
  AUCTION_PRICE decimal
  START_DATE date
  END_DATE date
  CREATED_DATE date
  UPDATED_DATE date
}

Table VENUE {
  VENUE_ID int [pk]
  VENUE_NAME varchar
  CITY varchar
  STATE varchar
  COUNTRY varchar
  CAPACITY int
  ESTABLISHED_YEAR int
  CREATED_DATE date
  UPDATED_DATE date
}

Table UMPIRE {
  UMPIRE_ID int [pk]
  FULL_NAME varchar
  NATIONALITY varchar
  ICC_PANEL varchar
  ACTIVE_FLAG char
  CREATED_DATE date
  UPDATED_DATE date
}

Table MATCH {
  MATCH_ID int [pk]
  SEASON_ID int
  VENUE_ID int
  MATCH_NUMBER int
  MATCH_DATE date
  TEAM1_ID int
  TEAM2_ID int
  TOSS_WINNER_ID int
  TOSS_DECISION varchar
  WINNER_TEAM_ID int
  PLAYER_OF_MATCH_ID int
  RESULT_TYPE varchar
  WIN_MARGIN int
  MATCH_STATUS varchar
  CREATED_DATE date
  UPDATED_DATE date
}

Table INNINGS {
  INNINGS_ID int [pk]
  MATCH_ID int
  INNINGS_NUMBER int
  BATTING_TEAM_ID int
  BOWLING_TEAM_ID int
  TOTAL_RUNS int
  TOTAL_WICKETS int
  OVERS_PLAYED decimal
  EXTRAS int
  CREATED_DATE date
  UPDATED_DATE date
}

Table DELIVERY {
  DELIVERY_ID bigint [pk]
  MATCH_ID int
  INNINGS_ID int
  OVER_NUMBER int
  BALL_NUMBER int
  BATTER_ID int
  NON_STRIKER_ID int
  BOWLER_ID int
  BATTER_RUNS int
  EXTRA_RUNS int
  TOTAL_RUNS int
  EXTRA_TYPE varchar
  IS_BOUNDARY char
  IS_SIX char
  CREATED_DATE date
}

Table WICKET {
  WICKET_ID bigint [pk]
  DELIVERY_ID bigint
  PLAYER_OUT_ID int
  DISMISSAL_TYPE varchar
  FIELDER_ID int
  CREATED_DATE date
}

Table PLAYER_STATISTICS {
  PLAYER_STAT_ID int [pk]
  PLAYER_ID int
  SEASON_ID int
  MATCHES_PLAYED int
  RUNS_SCORED int
  BALLS_FACED int
  HIGHEST_SCORE int
  BATTING_AVERAGE decimal
  STRIKE_RATE decimal
  WICKETS int
  ECONOMY decimal
  CREATED_DATE date
  UPDATED_DATE date
}

Table TEAM_STATISTICS {
  TEAM_STAT_ID int [pk]
  TEAM_ID int
  SEASON_ID int
  MATCHES_PLAYED int
  WINS int
  LOSSES int
  POINTS int
  NET_RUN_RATE decimal
  CREATED_DATE date
  UPDATED_DATE date
}

Table VENUE_STATISTICS {
  VENUE_STAT_ID int [pk]
  VENUE_ID int
  SEASON_ID int
  MATCHES_HOSTED int
  HIGHEST_SCORE int
  LOWEST_SCORE int
  AVERAGE_FIRST_INNINGS decimal
  AVERAGE_SECOND_INNINGS decimal
  CREATED_DATE date
  UPDATED_DATE date
}

Table POINTS_TABLE {
  POINTS_TABLE_ID int [pk]
  SEASON_ID int
  TEAM_ID int
  POSITION int
  MATCHES int
  WINS int
  LOSSES int
  POINTS int
  NET_RUN_RATE decimal
  QUALIFIED_FLAG char
  CREATED_DATE date
}

Table ETL_JOB {
  JOB_ID int [pk]
  JOB_NAME varchar
  START_TIMESTAMP timestamp
  END_TIMESTAMP timestamp
  STATUS varchar
  RECORDS_READ int
  RECORDS_INSERTED int
  RECORDS_UPDATED int
  RECORDS_REJECTED int
  EXECUTION_TIME_SEC decimal
  CREATED_DATE date
}

Table ERROR_LOG {
  ERROR_ID bigint [pk]
  JOB_ID int
  SOURCE_FILE varchar
  ERROR_TYPE varchar
  ERROR_MESSAGE varchar
  RECORD_NUMBER int
  ERROR_TIMESTAMP timestamp
  RESOLVED_FLAG char
}

//////////////////////////////////////////////////////////
// Relationships
//////////////////////////////////////////////////////////

Ref: SEASON.COMPETITION_ID > COMPETITION.COMPETITION_ID

Ref: TEAM.COMPETITION_ID > COMPETITION.COMPETITION_ID

Ref: MATCH.SEASON_ID > SEASON.SEASON_ID

Ref: MATCH.VENUE_ID > VENUE.VENUE_ID

Ref: MATCH.TEAM1_ID > TEAM.TEAM_ID

Ref: MATCH.TEAM2_ID > TEAM.TEAM_ID

Ref: MATCH.TOSS_WINNER_ID > TEAM.TEAM_ID

Ref: MATCH.WINNER_TEAM_ID > TEAM.TEAM_ID

Ref: MATCH.PLAYER_OF_MATCH_ID > PLAYER.PLAYER_ID

Ref: PLAYER_TEAM_HISTORY.PLAYER_ID > PLAYER.PLAYER_ID

Ref: PLAYER_TEAM_HISTORY.TEAM_ID > TEAM.TEAM_ID

Ref: PLAYER_TEAM_HISTORY.SEASON_ID > SEASON.SEASON_ID

Ref: INNINGS.MATCH_ID > MATCH.MATCH_ID

Ref: INNINGS.BATTING_TEAM_ID > TEAM.TEAM_ID

Ref: INNINGS.BOWLING_TEAM_ID > TEAM.TEAM_ID

Ref: DELIVERY.MATCH_ID > MATCH.MATCH_ID

Ref: DELIVERY.INNINGS_ID > INNINGS.INNINGS_ID

Ref: DELIVERY.BATTER_ID > PLAYER.PLAYER_ID

Ref: DELIVERY.NON_STRIKER_ID > PLAYER.PLAYER_ID

Ref: DELIVERY.BOWLER_ID > PLAYER.PLAYER_ID

Ref: WICKET.DELIVERY_ID > DELIVERY.DELIVERY_ID

Ref: WICKET.PLAYER_OUT_ID > PLAYER.PLAYER_ID

Ref: WICKET.FIELDER_ID > PLAYER.PLAYER_ID

Ref: PLAYER_STATISTICS.PLAYER_ID > PLAYER.PLAYER_ID

Ref: PLAYER_STATISTICS.SEASON_ID > SEASON.SEASON_ID

Ref: TEAM_STATISTICS.TEAM_ID > TEAM.TEAM_ID

Ref: TEAM_STATISTICS.SEASON_ID > SEASON.SEASON_ID

Ref: VENUE_STATISTICS.VENUE_ID > VENUE.VENUE_ID

Ref: VENUE_STATISTICS.SEASON_ID > SEASON.SEASON_ID

Ref: POINTS_TABLE.SEASON_ID > SEASON.SEASON_ID

Ref: POINTS_TABLE.TEAM_ID > TEAM.TEAM_ID

Ref: ERROR_LOG.JOB_ID > ETL_JOB.JOB_ID